# Xixapay webhook signature key from the Xixapay dashboard.
# Keep empty until configured; signed webhooks will be rejected without it.
XIXAPAY_WEBHOOK_SECRET=

# Public image URL used in transactional email headers.
EMAIL_LOGO_URL=https://www.ctex.online/Logo-email.png

# Payouts use an outbound transfer provider independent from collection payments.
# Select MONNIFY or XIXAPAY. Xixapay reuses its API credentials/business ID below.
PAYOUT_PROVIDER=MONNIFY
MONNIFY_PAYOUT_SOURCE_ACCOUNT=
MONNIFY_PAYOUT_ASYNC=false
MONNIFY_PROVIDER_FEE_BPS=150
XIXAPAY_PROVIDER_FEE_BPS=100

# Xixapay credentials are shared by collection and payout adapters.
XIXAPAY_BASE_URL=https://api.xixapay.com
XIXAPAY_API_KEY=
XIXAPAY_API_SECRET=
XIXAPAY_BUSINESS_ID=
